# auth-mcp — see src/config/env.ts for every setting and its default.
NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# Public URL of this resource server: token audience and PRM `resource`.
MCP_RESOURCE=http://localhost:3100/mcp
# Browser origins allowed to call /mcp (comma-separated). Native clients send no Origin.
MCP_ALLOWED_ORIGINS=

HYDRA_ISSUER=https://hydra.authdev.dev.example.com
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445

# hydra | jinbe | dev   (dev = fixed principal, NODE_ENV=development only)
TOKEN_VERIFIER=dev
DEV_SUBJECT=dev-user-id
DEV_EMAIL=dev@localhost
DEV_ORG=00000000-0000-4000-8000-000000000001
DEV_SCOPES=mcp admin:read users:read audit:read

JINBE_URL=http://localhost:3000
# Projected ServiceAccount token (audience jinbe); unused with TOKEN_VERIFIER=dev.
ACTOR_TOKEN_PATH=/var/run/secrets/tokens/jinbe/token

MCP_ENABLED=true
MCP_READ_ONLY=true
# KILL_SWITCH_FILE=/etc/auth-mcp/kill-switches.json
RATE_READS_PER_MIN=60
RATE_WRITES_PER_MIN=10
MCP_EXPOSE_UNWIRED_TOOLS=false
